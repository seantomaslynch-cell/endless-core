# Node / npm
node_modules/

# www/ is a mechanical copy of index.html/style.css/game.js (see
# `npm run sync:www`), generated as Capacitor's webDir target — the root
# copies of those three files stay the single source of truth.
www/

# Android build artifacts / machine-local files. local.properties holds an
# absolute SDK path specific to this machine; every dev machine regenerates
# it (see android/local.properties in build-debug.sh's own instructions).
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/captures/
android/*.iml
android/.idea/

# Play Store signing credentials — never commit these. Losing them is
# recoverable via Play App Signing's key-reset support flow, but a leak is
# not: anyone with this file + its passwords could sign an update to this
# app's real package name.
android/app/upload-keystore.jks
android/keystore.properties

