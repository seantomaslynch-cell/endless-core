{
  "name": "endlesscore",
  "version": "1.0.0",
  "description": "An endless vertical drilling game built with vanilla HTML5 Canvas and JavaScript.",
  "main": "game.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "sync:www": "node -e \"require('fs').mkdirSync('www',{recursive:true});['index.html','style.css','game.js','menu-bg.jpg','base-scene-tier0.jpg','base-scene-tier1.jpg','base-scene-tier2.jpg','base-scene-tier3.jpg'].forEach(f=>require('fs').copyFileSync(f,'www/'+f))\"",
    "sync:ios": "npm run sync:www && npx cap sync ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seantomaslynch-cell/endless-core.git"
  },
